# ============================================
# Base Stage - Common setup for all stages
# ============================================
FROM node:20-alpine AS base

WORKDIR /app

RUN apk add --no-cache \
    dumb-init \
    libc6-compat \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nestjs

# Enable Corepack to use Yarn
RUN corepack enable

ENV NODE_ENV=production

# ============================================
# Dependencies Stage - Install all dependencies
# ============================================
FROM base AS deps
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# ============================================
# Development Stage - For local development
# ============================================
FROM base AS development
ENV NODE_ENV=development
COPY package.json yarn.lock ./
RUN yarn install
COPY --chown=nestjs:nodejs . .
EXPOSE 4001
USER nestjs
CMD ["yarn", "start:gateway:dev"]

# ============================================
# Builder Stage - Build the application
# ============================================
FROM base AS builder
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# Copy commonlib first (shared library)
COPY --chown=nestjs:nodejs libs ./libs

# Copy the specific app
COPY --chown=nestjs:nodejs apps/gateway ./apps/gateway

# Copy nest-cli and tsconfig
COPY --chown=nestjs:nodejs nest-cli.json tsconfig.json tsconfig.build.json ./

# Build the application
RUN yarn build:gateway

# Install production dependencies
RUN yarn install --production --frozen-lockfile && yarn cache clean

# ============================================
# Production Stage - Optimized runtime image
# ============================================
FROM base AS production
ENV NODE_ENV=production

COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/package.json ./
COPY --from=builder --chown=nestjs:nodejs /app/yarn.lock ./

# Copy migrations
COPY --from=builder --chown=nestjs:nodejs /app/libs/commonlib/src/migrations ./libs/commonlib/src/migrations

# CRITICAL: Copy proto files - this ensures they're available at runtime
COPY --from=builder --chown=nestjs:nodejs /app/libs/commonlib/src/protos ./dist/protos

COPY --chown=nestjs:nodejs scripts ./scripts

RUN mkdir -p logs && chown nestjs:nodejs logs
EXPOSE 4001
# EXPOSE 50051

USER nestjs
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/apps/gateway/main"]

# ============================================
# Test Stage - For running tests
# ============================================
FROM development AS test
COPY --chown=nestjs:nodejs test ./test
CMD ["yarn", "test:e2e"]