{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/r8/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "webpackConfigPath": "webpack.config.js",
    "tsConfigPath": "apps/r8/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/r8",
  "projects": {
    "r8": {
      "type": "application",
      "root": "apps/r8",
      "entryFile": "main",
      "sourceRoot": "apps/r8/src",
      "compilerOptions": {
        "tsConfigPath": "apps/r8/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/commonlib/src/protos/**/*.proto",
            "outDir": "dist/protos",
            "watchAssets": true
          }
        ]
      }
    },
    "searchengine": {
      "type": "application",
      "root": "apps/searchengine",
      "entryFile": "main",
      "sourceRoot": "apps/searchengine/src",
      "compilerOptions": {
        "tsConfigPath": "apps/searchengine/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/commonlib/src/protos/**/*.proto",
            "outDir": "dist/protos",
            "watchAssets": true
          }
        ]
      }
    },
    "commonlib": {
      "type": "library",
      "root": "libs/commonlib",
      "entryFile": "index",
      "sourceRoot": "libs/commonlib/src",
      "compilerOptions": {
        "tsConfigPath": "libs/commonlib/tsconfig.lib.json",
        "assets": [
          {
            "include": "protos/**/*.proto",
            "outDir": "dist/protos",
            "watchAssets": true
          }
        ]
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/commonlib/src/protos/**/*.proto",
            "outDir": "dist/protos",
            "watchAssets": true
          }
        ]
      }
    },
    "media": {
      "type": "application",
      "root": "apps/media",
      "entryFile": "main",
      "sourceRoot": "apps/media/src",
      "compilerOptions": {
        "tsConfigPath": "apps/media/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/commonlib/src/protos/**/*.proto",
            "outDir": "dist/protos",
            "watchAssets": true
          }
        ]
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json",
        "assets": [
          {
            "include": "../../../libs/commonlib/src/protos/**/*.proto",
            "outDir": "dist/protos",
            "watchAssets": true
          }
        ]
      }
    }
  }
}